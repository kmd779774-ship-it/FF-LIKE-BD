rules_version='2';
service cloud.firestore{
match /databases/{db}/documents{
match /users/{uid}{allow read,write: if request.auth!=null && request.auth.uid==uid;}
match /orders/{id}{allow create,read: if request.auth!=null;}
match /packages/{id}{allow read: if true; allow write: if request.auth.token.admin==true;}
match /banners/{id}{allow read: if true; allow write: if request.auth.token.admin==true;}
}}